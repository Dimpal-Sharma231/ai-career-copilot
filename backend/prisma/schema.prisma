// Prisma Schema for AI Career Copilot
// Provider: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  password            String?          // Optional for Google OAuth users
  name                String
  avatarUrl           String?          @default("")
  provider            String?          @default("local") // "local" or "google"
  college             String?          @default("")
  graduationYear      String?          @default("2026")
  targetRole          String?          @default("Software Development Engineer (SDE)")
  targetCompanies     String?          @default("Zomato, Razorpay, Flipkart")
  leetcodeUrl         String?          @default("")
  githubUrl           String?          @default("")
  resumeSkills        String?          @default("[]") // JSON encoded string for SQLite
  dsaStreak           Int              @default(0)
  dsaSolved           Int              @default(0)
  dsaTarget           Int              @default(191) // Striver's SDE Sheet total
  striverSolved       Int              @default(0)
  profileStrength     Int              @default(20)
  readinessScore      Int              @default(0)
  onboardingCompleted Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt @default(now())

  // Relations
  resumes             Resume[]
  applications        JobApplication[]
  matchHistories      MatchHistory[]
  dsaStats            DSAStats?
  mockInterviews      MockInterview[]
  projects            Project[]
  skills              Skill[]

  @@map("users")
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  fileName       String
  fileUrl        String?  @default("")
  extractedText  String
  skillsArray    String   @default("[]") // JSON string for SQLite
  shortlistScore Int      @default(85)
  createdAt      DateTime @default(now())

  // Relation to User
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

model DSAStats {
  id            String   @id @default(uuid())
  userId        String   @unique
  streak        Int      @default(0)
  solved        Int      @default(0)
  totalTarget   Int      @default(191)
  striverSolved Int      @default(0)
  easyCount     Int      @default(0)
  mediumCount   Int      @default(0)
  hardCount     Int      @default(0)
  updatedAt     DateTime @updatedAt @default(now())

  // Relation to User
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dsa_stats")
}

model MockInterview {
  id              String                 @id @default(uuid())
  userId          String
  role            String                 @default("Software Development Engineer (SDE)")
  company         String?                @default("General Placement Drive")
  status          String                 @default("completed") // in_progress, completed
  averageScore    Float                  @default(0) // 0-10 or 0-100
  feedbackSummary String?                @default("")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt @default(now())

  // Relations
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        MockInterviewMessage[]

  @@index([userId])
  @@map("mock_interviews")
}

model MockInterviewMessage {
  id            String        @id @default(uuid())
  interviewId   String
  sender        String        // "ai" or "user"
  content       String
  score         Float?        // 0-10
  feedback      String?       // AI critique
  starAnalysis  String?       @default("{}") // JSON: { situation: bool, task: bool, action: bool, result: bool }
  idealKeywords String?       @default("[]") // JSON array of string keywords
  createdAt     DateTime      @default(now())

  // Relation to MockInterview
  interview     MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@map("mock_interview_messages")
}

model Project {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String
  technologies String   @default("[]") // JSON string or comma-separated
  link         String?  @default("")
  startDate    String?  @default("")
  endDate      String?  @default("")
  createdAt    DateTime @default(now())

  // Relation to User
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

model Skill {
  id          String   @id @default(uuid())
  userId      String
  category    String   @default("Technical") // Languages, Frameworks, Cloud, Core
  name        String
  proficiency String   @default("Proficient")
  createdAt   DateTime @default(now())

  // Relation to User
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("skills")
}

model PlacementDrive {
  id              String   @id @default(uuid())
  companyName     String
  role            String
  deadline        DateTime
  applicationLink String   @default("")
  status          String   @default("Open") // Open, Closing Soon, Urgent, Closed
  salary          String?  @default("") // e.g. "₹22-26 LPA" or "₹80,000/mo"
  location        String?  @default("Bangalore / Hybrid")
  eligibility     String?  @default("B.Tech / B.E CSE/IT/ECE (>= 7.0 CGPA)")
  tier            String?  @default("Dream (15+ LPA)")
  createdAt       DateTime @default(now())

  @@map("placement_drives")
}

model JobApplication {
  id             String   @id @default(uuid())
  userId         String
  company        String
  role           String
  status         String   @default("Applied") // Applied, Interviewing, Offered, Rejected
  appliedDate    DateTime @default(now())
  jobDescription String?  @default("")
  matchScore     Float    @default(80)
  link           String?  @default("")
  notes          String?  @default("")

  // Relation to User
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("job_applications")
}

model MatchHistory {
  id             String   @id @default(uuid())
  userId         String
  company        String?  @default("")
  role           String?  @default("")
  jobDescription String
  matchScore     Int      @default(0)
  matchedSkills  String   @default("[]") // JSON string
  missingSkills  String   @default("[]") // JSON string
  recommendation String?  @default("")
  createdAt      DateTime @default(now())

  // Relation to User
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("match_histories")
}
